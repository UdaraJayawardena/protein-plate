# Copy this file to ".env" and fill in your own Atlas connection string.
# Use letters and numbers only in the password (symbols need special encoding).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional: database name (default is "proteinplate")
# MONGODB_DB=proteinplate

APP_USER=<>    
APP_PASSWORD=<>
